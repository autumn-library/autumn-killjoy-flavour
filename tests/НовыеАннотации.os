#Использовать autumn
#Использовать asserts
#Использовать ".."
#Использовать "."

Функция ПостроитьПоделку()

	Поделка = Новый Поделка();
	Поделка
		.ДобавитьЗаготовку(Тип("ИнициализаторТестов"))
		.ЗапуститьПриложение();

	Возврат Поделка;

КонецФункции

&Тест
Процедура ПравилаОбработкиОтключаютВсеНапильники() Экспорт
	// Дано

	// Когда
	Поделка = ПостроитьПоделку();
	Компонент = Поделка.НайтиЖелудь("КомпонентСОтключеннойОбработкой");

	// Тогда
	Ожидаем.Что(Компонент, "Компонент с отключённой обработкой должен создаваться")
		.Не_().Равно(Неопределено);
	Ожидаем.Что(Компонент.ВнедренныйКомпонент, "При отключении всех обработчиков внедрение не выполняется")
		.Равно(Неопределено);
КонецПроцедуры

&Тест
Процедура ПравилаОбработкиОтключаютНазванныйНапильник() Экспорт
	// Дано

	// Когда
	Поделка = ПостроитьПоделку();
	Компонент = Поделка.НайтиЖелудь("КомпонентСИзбирательнойОбработкой");

	// Тогда
	Ожидаем.Что(Компонент.ВнедренныйКомпонент, "Названный обработчик применяться не должен")
		.Равно(Неопределено);
КонецПроцедуры

&Тест
Процедура ФазаИнициализацииОтключаетНапильники() Экспорт
	// Дано

	// Когда
	Поделка = ПостроитьПоделку();
	Компонент = Поделка.НайтиЖелудь("КомпонентФазыИнициализации");

	// Тогда
	Ожидаем.Что(Компонент, "Компонент фазы инициализации должен создаваться")
		.Не_().Равно(Неопределено);
	Ожидаем.Что(Компонент.ВнедренныйКомпонент, "На фазе инициализации напильники не применяются")
		.Равно(Неопределено);
КонецПроцедуры

&Тест
Процедура ОбработчикОпределенияПолучаетОпределенияЖелудей() Экспорт
	// Дано
	ПутьЛог = ОбъединитьПути(КаталогВременныхФайлов(), "killjoy_priemka_test.log");
	Если Новый Файл(ПутьЛог).Существует() Тогда
		УдалитьФайлы(ПутьЛог);
	КонецЕсли;

	// Когда
	ПостроитьПоделку();

	// Тогда
	Ожидаем.Что(Новый Файл(ПутьЛог).Существует(), "Обработчик определения компонента должен сработать")
		.Равно(Истина);
	Текст = Новый ЧтениеТекста(ПутьЛог).Прочитать();
	Ожидаем.Что(СтрНайти(Текст, "СоберательОпределений") > 0, "Обработчик должен получать определения желудей")
		.Равно(Истина);
КонецПроцедуры
